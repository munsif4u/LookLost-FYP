<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".PersonFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="24dp"
            android:layout_marginBottom="24dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:id="@+id/textcontent">
                <TextView
                    android:id="@+id/textView7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Items Page"
                    android:textColor="@color/md_theme_light_onPrimary"
                    android:textSize="30sp"
                    android:textStyle="bold"  />

                <Button
                    android:id="@+id/btn_resetPersonList"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="38dp"
                    android:text="Reset List"
                    android:textAllCaps="false"
                    android:textSize="12sp"/>

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/share_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="8dp"
                    android:src="@drawable/baseline_help_outline_24"
                    app:civ_border_color="#FFFFFF"
                    app:civ_border_width="0dp"/>

            </RelativeLayout>

            <LinearLayout
                android:id="@+id/homeusername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_below="@id/textcontent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <SearchView
                    android:id="@+id/person_search"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/search_container"
                    android:backgroundTint="@android:color/white"
                    android:iconifiedByDefault="false"
                    android:queryBackground="@android:color/transparent"
                    android:queryHint="Search Items..."/>
                <CheckBox
                    android:id="@+id/personicon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:button="@drawable/filter_checkbtn"
                    app:buttonTint="@android:color/white"
                    />

            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:background="@drawable/background_container2"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/personViewId"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="12dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/add_image" />

            <Button
                android:id="@+id/secretbutton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/border"
                android:text="Search by Image"
                android:textSize="16sp"
                android:textStyle="bold"/>
<!--            <Button-->
<!--                android:id="@+id/secretbutton2"-->
<!--                android:layout_width="match_parent"-->
<!--                android:layout_height="50dp"-->
<!--                android:layout_marginRight="16dp"-->
<!--                android:layout_marginLeft="16dp"-->
<!--                android:text="Google Search"-->
<!--                android:background="@drawable/border"-->
<!--                android:textSize="18dp"-->
<!--                android:textStyle="bold"/>-->


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/person_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                tools:listitem="@layout/list_items"/>
        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/extended_fab_person"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/FAB_text"
        android:text="@string/FAB_text"
        android:textStyle="bold"
        app:icon="@drawable/baseline_add_24" />
</FrameLayout>